{
  "expo": {
    "name": "Run, Chip, Queen",
    "slug": "run-chip-queen",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "runchipqueen",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#03281B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minimatrix.run-chip-queen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#03281B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#03281B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
